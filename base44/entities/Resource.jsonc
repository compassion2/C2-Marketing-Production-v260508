{
  "name": "Resource",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Framework",
        "Case Study",
        "Research",
        "Article",
        "Guide"
      ],
      "default": "Article"
    },
    "author": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "published_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "title",
    "description"
  ]
}